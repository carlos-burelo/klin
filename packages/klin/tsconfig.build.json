{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "klin build (emite por archivo, sin empaquetar)",
  "extends": "../../tools/config/tsconfig.react-library.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"]
}
