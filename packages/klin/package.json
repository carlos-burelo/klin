{
  "name": "@carlos-burelo/klin",
  "version": "2.0.0",
  "description": "Gráficas SSR-friendly (d3 para cálculo, SVG puro, tooltip portal mínimo)",
  "license": "AGPL-3.0-or-later",
  "author": "Carlos Burelo",
  "keywords": [
    "charts",
    "d3",
    "svg",
    "ssr",
    "react",
    "server-components",
    "visualization",
    "dashboard"
  ],
  "homepage": "https://github.com/carlos-burelo/klin#readme",
  "bugs": {
    "url": "https://github.com/carlos-burelo/klin/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "EXCEPTION",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlos-burelo/klin.git",
    "directory": "packages/klin"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-links.mjs && node scripts/copy-css.mjs",
    "prepublishOnly": "node scripts/clean.mjs && pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-chord": "^3.0.1",
    "d3-contour": "^4.0.2",
    "d3-force": "^3.0.0",
    "d3-format": "^3.1.0",
    "d3-hexbin": "^0.2.2",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/d3-array": "^3.2.1",
    "@types/d3-chord": "^3.0.6",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-force": "^3.0.10",
    "@types/d3-format": "^3.0.4",
    "@types/d3-hexbin": "^0.2.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
