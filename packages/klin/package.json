{
  "name": "@carlos-burelo/klin",
  "version": "1.0.1",
  "description": "Gráficas SSR-friendly (d3 para cálculo, SVG puro, tooltip portal mínimo)",
  "license": "AGPL-3.0-or-later",
  "author": "Carlos Burelo",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "LICENSE",
    "EXCEPTION",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlos-burelo/klin.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-force": "^3.0.0",
    "d3-format": "^3.1.0",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/d3-array": "^3.2.1",
    "@types/d3-force": "^3.0.10",
    "@types/d3-format": "^3.0.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
